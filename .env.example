# Mẫu cho .env (chép thành .env rồi điền). File .env không được commit.

# Postgres local chạy bằng docker-compose.yml. Tự đặt một mật khẩu; ConnectionStrings__Default bên dưới phải dùng cùng mật khẩu.
POSTGRES_PASSWORD=

# Chuỗi kết nối của app (Npgsql), dùng cho dotnet run và các script trong tools/. Khi chạy ở nơi khác, đặt thành biến môi trường cùng tên.
ConnectionStrings__Default=Host=127.0.0.1;Port=5433;Database=threads_toxic;Username=threads;Password=<mật khẩu như POSTGRES_PASSWORD>;Maximum Pool Size=20

# Tài khoản (bắt buộc, thiếu thì app không khởi động). Tạo bằng: python tools/new_token.py --index 0 --name "<tên>" --role admin
# Mỗi người 3 dòng, index 0, 1, 2...; chỉ lưu SHA-256 của mã, mã gốc gửi riêng cho người dùng.
Auth__Users__0__Name=
Auth__Users__0__Role=admin
Auth__Users__0__TokenSha256=

# (Tùy chọn) Tunnel cố định của Cloudflare: token lấy khi tạo tunnel trên Zero Trust. Để trống thì tools/tunnel.ps1 dùng tunnel tạm.
CLOUDFLARE_TUNNEL_TOKEN=
