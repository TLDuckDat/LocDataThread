# Mẫu cho .env (chép thành .env rồi điền). File .env không được commit.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Connect > Direct > Session pooler trên dashboard Supabase
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Chuỗi kết nối của app (Npgsql); khi deploy đặt thành biến môi trường cùng tên. Dạng:
# Host=<SUPABASE_DB_HOST>;Port=5432;Database=postgres;Username=<SUPABASE_DB_USER>;Password=<mật khẩu>;SSL Mode=Require;Maximum Pool Size=15
ConnectionStrings__Default=

# Tài khoản (bắt buộc, thiếu thì app không khởi động). Tạo bằng: python tools/new_token.py --index 0 --name "<tên>" --role admin
# Mỗi người 3 dòng, index 0, 1, 2...; chỉ lưu SHA-256 của mã, mã gốc gửi riêng cho người dùng.
Auth__Users__0__Name=
Auth__Users__0__Role=admin
Auth__Users__0__TokenSha256=
